<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="24dp">

    <!-- Clean Sleek Modern Glass Dialog Card -->
    <LinearLayout
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_modern"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="24dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:elevation="16dp">

        <!-- Smooth Minimal Glowing Circular Spinner -->
        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#18FFFF"
            android:indeterminateTintMode="src_in"
            android:layout_gravity="center" />

        <!-- Verification Title -->
        <TextView
            android:id="@+id/loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Verifying With Server..."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.04"
            android:gravity="center" />

        <!-- Subtitle Note -->
        <TextView
            android:id="@+id/loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Please wait a moment"
            android:textSize="12sp"
            android:textColor="#80FFFFFF"
            android:gravity="center" />

    </LinearLayout>
</LinearLayout>
