<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="24dp">

    <!-- Blurred Pure White Glass Dialog Card -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/dialog_blur_view"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_white_blur"
        android:clipToOutline="true"
        app:blurOverlayColor="#15FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="22dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <!-- Smooth Glowing Circular Spinner -->
            <ProgressBar
                android:id="@+id/loading_spinner"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:indeterminate="true"
                android:indeterminateTint="#00B0FF"
                android:indeterminateTintMode="src_in"
                android:layout_gravity="center" />

            <!-- Verification Title -->
            <TextView
                android:id="@+id/loading_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Verifying With Server..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:letterSpacing="0.04"
                android:gravity="center" />

            <!-- Subtitle Note -->
            <TextView
                android:id="@+id/loading_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please wait a moment"
                android:textSize="12sp"
                android:textColor="#555566"
                android:gravity="center" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</LinearLayout>
