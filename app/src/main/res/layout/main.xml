<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<RelativeLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/bg_main">

		<!-- Background Image -->
		<ImageView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:src="@drawable/bg_main"
			android:scaleType="centerCrop"
			android:focusable="false" />

		<!-- Dark Ambient Vignette Overlay -->
		<View
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#55000000" />

		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal" />

		<!-- TOP HEADER (Pinned to top) -->
		<LinearLayout
			android:id="@+id/linear43"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
			android:paddingTop="38dp"
			android:paddingBottom="12dp"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:gravity="center_horizontal"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:text="ModX Lab"
				android:textSize="32sp"
				android:textStyle="bold"
				android:textColor="#18FFFF"
				android:shadowColor="#CC000000"
				android:shadowDx="2"
				android:shadowDy="2"
				android:shadowRadius="12" />
			<TextView
				android:id="@+id/textview_welcome"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="3dp"
				android:gravity="center_horizontal"
				android:text="WELCOME TO MODX LAB"
				android:textSize="12sp"
				android:textStyle="bold"
				android:letterSpacing="0.1"
				android:textColor="#FFD700"
				android:shadowColor="#E0000000"
				android:shadowDx="1"
				android:shadowDy="1"
				android:shadowRadius="6" />
			<!-- Hidden helper layouts for compatibility -->
			<LinearLayout
				android:id="@+id/linear45"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:visibility="gone"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear49"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:visibility="gone"
					android:orientation="horizontal" />
			</LinearLayout>
		</LinearLayout>

		<!-- CENTER LOGIN CARD (Vertically centered) -->
		<eightbitlab.com.blurview.BlurView
			android:id="@+id/blur_view"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:layout_marginLeft="24dp"
			android:layout_marginRight="24dp"
			android:maxWidth="350dp"
			app:blurOverlayColor="#250F172A">
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_glass_card"
				android:paddingTop="24dp"
				android:paddingBottom="22dp"
				android:paddingLeft="22dp"
				android:paddingRight="22dp"
				android:gravity="center_horizontal"
				android:orientation="vertical">

				<!-- Login Card Title -->
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Login"
					android:textSize="22sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:letterSpacing="0.04"
					android:layout_marginBottom="16dp" />

				<!-- Username Field -->
				<LinearLayout
					android:id="@+id/linear41"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="USERNAME"
						android:textSize="11sp"
						android:textStyle="bold"
						android:letterSpacing="0.08"
						android:textColor="#CFD8DC" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="match_parent"
					android:layout_height="38dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<EditText
						android:id="@+id/edittext1"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:textCursorDrawable="@drawable/cursor_cyan"
						android:textColorHighlight="#4018FFFF"
						android:hint="Enter username"
						android:textColorHint="#75FFFFFF"
						android:singleLine="true" />
					<ImageView
						android:id="@+id/iv_user_icon"
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:src="@drawable/ic_user_minimal"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<!-- Horizontal underline for Username -->
				<View
					android:id="@+id/line_username"
					android:layout_width="match_parent"
					android:layout_height="1.2dp"
					android:background="#55FFFFFF"
					android:layout_marginTop="2dp" />

				<!-- Password Field -->
				<LinearLayout
					android:id="@+id/linear37"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview0"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="PASSWORD"
						android:textSize="11sp"
						android:textStyle="bold"
						android:letterSpacing="0.08"
						android:textColor="#CFD8DC" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="match_parent"
					android:layout_height="38dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<EditText
						android:id="@+id/edittext2"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:textCursorDrawable="@drawable/cursor_cyan"
						android:textColorHighlight="#4018FFFF"
						android:hint="Enter password"
						android:textColorHint="#75FFFFFF"
						android:inputType="textPassword"
						android:singleLine="true" />
					<ImageView
						android:id="@+id/iv_lock_icon"
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:src="@drawable/ic_lock_minimal"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<!-- Horizontal underline for Password -->
				<View
					android:id="@+id/line_password"
					android:layout_width="match_parent"
					android:layout_height="1.2dp"
					android:background="#55FFFFFF"
					android:layout_marginTop="2dp" />

				<!-- Checkboxes Row -->
				<LinearLayout
					android:id="@+id/linear7"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<CheckBox
						android:id="@+id/checkbox1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Remember Me"
						android:textSize="12sp"
						android:textColor="#E0E0E0"
						android:buttonTint="#00B489" />
					<LinearLayout
						android:id="@+id/linear31"
						android:layout_width="0dp"
						android:layout_height="1dp"
						android:layout_weight="1"
						android:orientation="horizontal" />
					<CheckBox
						android:id="@+id/checkbox2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Show Pass"
						android:textSize="12sp"
						android:textColor="#E0E0E0"
						android:buttonTint="#00B489" />
				</LinearLayout>

				<!-- Login Button -->
				<LinearLayout
					android:id="@+id/linear8"
					android:layout_width="match_parent"
					android:layout_height="44dp"
					android:layout_marginTop="16dp"
					android:gravity="center"
					android:orientation="horizontal">
					<Button
						android:id="@+id/button1"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:background="@drawable/bg_btn_primary"
						android:text="LOGIN"
						android:textSize="15sp"
						android:textStyle="bold"
						android:letterSpacing="0.06"
						android:textColor="#FFFFFF" />
				</LinearLayout>

				<!-- Links -->
				<LinearLayout
					android:id="@+id/linear38"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:gravity="center"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Contact ModX Lab"
						android:textSize="12sp"
						android:textColor="#B0BEC5" />
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:text="Contact Now"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#18FFFF" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/linear39"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="5dp"
					android:gravity="center"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Find me on Facebook"
						android:textSize="12sp"
						android:textColor="#B0BEC5" />
					<TextView
						android:id="@+id/textview9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:text="Find Now"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#18FFFF" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/linear40"
					android:layout_width="match_parent"
					android:layout_height="2dp"
					android:orientation="horizontal" />
			</LinearLayout>
		</eightbitlab.com.blurview.BlurView>

		<!-- BOTTOM FOOTER (Pinned to bottom of screen) -->
		<LinearLayout
			android:id="@+id/linear_footer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_alignParentBottom="true"
			android:paddingBottom="20dp"
			android:paddingTop="10dp"
			android:gravity="center_horizontal"
			android:orientation="vertical">

			<!-- Hidden helper layout for compatibility -->
			<LinearLayout
				android:id="@+id/linear47"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:visibility="gone"
				android:orientation="horizontal" />

			<TextView
				android:id="@+id/textview_creator_typesafe"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="CREATOR : MODX LAB  •  TYPE : SAFE"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="#00E676"
				android:shadowColor="#CC000000"
				android:shadowDx="1"
				android:shadowDy="1"
				android:shadowRadius="4"
				android:gravity="center" />

			<TextView
				android:id="@+id/textview19"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="COPYRIGHT © ModX Lab 2026"
				android:textSize="11sp"
				android:textColor="#FFEE58"
				android:alpha="0.95"
				android:shadowColor="#CC000000"
				android:shadowDx="1"
				android:shadowDy="1"
				android:shadowRadius="4"
				android:gravity="center" />
		</LinearLayout>

	</RelativeLayout>
</LinearLayout>
