<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_modern"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:elevation="18dp">

        <!-- Glowing Check Icon -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_check_circle_neon"
            android:scaleType="fitCenter" />

        <!-- Title -->
        <TextView
            android:id="@+id/dialog_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="SUCCESS !"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:letterSpacing="0.08"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Authentication Verified"
            android:textSize="12sp"
            android:textColor="#90A4AE"
            android:gravity="center" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#25FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- User Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:orientation="vertical">

            <!-- Row: User Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User Name"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Row: Register Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Date Of Register"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#18FFFF" />
            </LinearLayout>

            <!-- Row: Valid Till -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Valid Till"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_valid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24/09/2026"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700" />
            </LinearLayout>

            <!-- Row: Seller -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seller"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_seller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ModX Lab"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />
            </LinearLayout>

            <!-- Row: Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Current Status"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVATED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:background="@drawable/bg_status_badge"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- OKAY Button -->
        <Button
            android:id="@+id/btn_dialog_okay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:text="OKAY"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.06"
            android:elevation="4dp" />

    </LinearLayout>
</LinearLayout>
