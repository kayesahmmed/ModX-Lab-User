<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_glass"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:elevation="14dp">

        <!-- Glowing Check Icon -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check_circle_neon"
            android:scaleType="fitCenter" />

        <!-- Title -->
        <TextView
            android:id="@+id/dialog_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="SUCCESS !"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:letterSpacing="0.08"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Authentication Verified"
            android:textSize="12sp"
            android:textColor="#90A4AE"
            android:gravity="center" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20FFFFFF"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- User Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:padding="12dp"
            android:orientation="vertical">

            <!-- Row: User Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User Name"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Row: Register Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Date Of Register"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#18FFFF" />
            </LinearLayout>

            <!-- Row: Valid Till -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Valid Till"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_valid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24/09/2026"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700" />
            </LinearLayout>

            <!-- Row: Seller -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seller"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_seller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ModX Lab"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />
            </LinearLayout>

            <!-- Row: Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Current Status"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
                <TextView
                    android:id="@+id/tv_dialog_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVATED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:background="#2000E676"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- OKAY Button -->
        <Button
            android:id="@+id/btn_dialog_okay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_primary"
            android:text="OKAY"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.06" />

    </LinearLayout>
</LinearLayout>
