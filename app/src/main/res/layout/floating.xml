<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="200dp"
		android:layout_height="wrap_content"
		android:layout_marginLeft="8dp"
		android:background="@android:color/transparent"
		android:gravity="center_horizontal"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/light"
			android:layout_width="match_parent"
			android:layout_height="3dp"
			android:padding="8dp"
			android:background="#0026FE"
			android:orientation="horizontal" />
		<TextView
			android:id="@+id/textview5"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:paddingTop="4dp"
			android:paddingRight="8dp"
			android:paddingBottom="4dp"
			android:text="ModX Lab"
			android:textSize="14sp"
			android:textStyle="bold"
			android:textColor="#18FFFF"
			android:focusable="false" />
	</LinearLayout>
	<RelativeLayout
		android:id="@+id/bg"
		android:layout_width="240dp"
		android:layout_height="300dp"
		android:alpha="0.9">
		<LinearLayout
			android:id="@+id/main"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal" />
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="240dp"
			android:layout_height="300dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="87dp"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal">
				<TextView
					android:id="@+id/textview1"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="3dp"
					android:gravity="center_horizontal"
					android:text="TextView"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_gravity="center_horizontal" />
				<TextView
					android:id="@+id/textview17"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="TextView"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="FREE FIRE MAX"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="wrap_content"
					android:layout_height="182dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/icon1"
						android:layout_width="38dp"
						android:layout_height="38dp"
						android:layout_margin="2dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_equalizer_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/icon2"
						android:layout_width="38dp"
						android:layout_height="38dp"
						android:layout_margin="2dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_person_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
				<ScrollView
					android:id="@+id/vscroll1"
					android:layout_width="match_parent"
					android:layout_height="match_parent">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="364dp"
						android:paddingLeft="1dp"
						android:paddingRight="1dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/l1"
							android:layout_width="match_parent"
							android:layout_height="182dp"
							android:paddingLeft="4dp"
							android:paddingTop="8dp"
							android:paddingRight="8dp"
							android:paddingBottom="8dp"
							android:orientation="vertical">
							<Button
								android:id="@+id/button1"
								android:layout_width="match_parent"
								android:layout_height="32dp"
								android:layout_marginBottom="15dp"
								android:background="#616FFF"
								android:text="WHITE HOLOGRAM [OFF]"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#9C27B0"
								android:alpha="0.8"
								android:textAllCaps="false" />
							<Button
								android:id="@+id/button2"
								android:layout_width="match_parent"
								android:layout_height="32dp"
								android:layout_marginBottom="15dp"
								android:background="#616FFF"
								android:text="GUN HOLOGRAM [OFF]"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#9C27B0"
								android:alpha="0.8"
								android:textAllCaps="false" />
							<Button
								android:id="@+id/button3"
								android:layout_width="match_parent"
								android:layout_height="32dp"
								android:layout_marginBottom="15dp"
								android:background="#616FFF"
								android:text="BODY HOLOGRAM [OFF]"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#9C27B0"
								android:alpha="0.8"
								android:textAllCaps="false" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/l2"
							android:layout_width="match_parent"
							android:layout_height="182dp"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginLeft="2dp"
								android:text="INFORMATION"
								android:textSize="14sp"
								android:textStyle="bold"
								android:textColor="#D500F9"
								android:focusable="false" />
							<LinearLayout
								android:id="@+id/linear9"
								android:layout_width="match_parent"
								android:layout_height="23dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview8"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="4dp"
									android:text="USERNAME :"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview12"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="1dp"
									android:text="TextView"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFEB3B"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear10"
								android:layout_width="match_parent"
								android:layout_height="23dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview9"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="4dp"
									android:text="CREATOR : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview13"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="1dp"
									android:text="ModX Lab"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#76FF03"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear11"
								android:layout_width="match_parent"
								android:layout_height="23dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview10"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="4dp"
									android:text="REGISTER TIME : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview14"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="1dp"
									android:text="TextView"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#673AB7"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear12"
								android:layout_width="match_parent"
								android:layout_height="23dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview11"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="4dp"
									android:text="EXPIRED TIME : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview15"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="1dp"
									android:text="TextView"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FF0000"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear13"
								android:layout_width="match_parent"
								android:layout_height="23dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview7"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="4dp"
									android:text="TYPE :  "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview16"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="1dp"
									android:text="SAFE"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#18FFFF"
									android:focusable="false" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</ScrollView>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="31dp"
				android:gravity="bottom"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview3"
					android:layout_width="75dp"
					android:layout_height="25dp"
					android:layout_marginLeft="5dp"
					android:layout_marginRight="5dp"
					android:background="#616FFF"
					android:gravity="left"
					android:text="EXIT"
					android:textSize="18sp"
					android:textColor="#FFFFFF"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="wrap_content"
					android:layout_height="20dp"
					android:orientation="horizontal"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview4"
					android:layout_width="75dp"
					android:layout_height="25dp"
					android:layout_marginLeft="5dp"
					android:layout_marginRight="5dp"
					android:background="#616FFF"
					android:gravity="right"
					android:text="CLOSE"
					android:textSize="18sp"
					android:textColor="#FFFFFF"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
