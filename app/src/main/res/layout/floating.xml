<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<!-- Minimized Floating Bubble Pill -->
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="145dp"
		android:layout_height="38dp"
		android:layout_margin="4dp"
		android:background="@drawable/bg_floating_pill"
		android:gravity="center"
		android:orientation="horizontal"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"
		android:elevation="10dp">
		<LinearLayout
			android:id="@+id/light"
			android:layout_width="9dp"
			android:layout_height="9dp"
			android:background="#00E676" />
		<TextView
			android:id="@+id/textview5"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:text="ModX Lab"
			android:textSize="13sp"
			android:textStyle="bold"
			android:textColor="#18FFFF"
			android:letterSpacing="0.04"
			android:focusable="false" />
	</LinearLayout>

	<!-- Main Floating Panel -->
	<RelativeLayout
		android:id="@+id/bg"
		android:layout_width="280dp"
		android:layout_height="340dp"
		android:background="@drawable/bg_floating_glass"
		android:elevation="16dp">

		<LinearLayout
			android:id="@+id/main"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal" />

		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="0dp"
			android:orientation="vertical">

			<!-- Header -->
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/textview1"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:text="MODX LAB PRO"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="#18FFFF"
					android:paddingLeft="16dp"
					android:paddingRight="28dp"
					android:clipToPadding="false"
					android:letterSpacing="0.06" />

				<!-- Hidden placeholder for backwards compatibility -->
				<TextView
					android:id="@+id/textview17"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:visibility="gone" />

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="FREE FIRE MAX"
					android:textSize="10sp"
					android:textStyle="bold"
					android:textColor="#FFD700"
					android:letterSpacing="0.1"
					android:focusable="false" />

				<!-- Subtle Divider -->
				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:background="#20FFFFFF"
					android:layout_marginTop="6dp" />
			</LinearLayout>

			<!-- Content Area (Tabs + Content) -->
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:orientation="horizontal">

				<!-- Side Navigation Tabs -->
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="44dp"
					android:layout_height="match_parent"
					android:gravity="top|center_horizontal"
					android:orientation="vertical"
					android:paddingTop="2dp">
					<LinearLayout
						android:id="@+id/icon1"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:layout_marginBottom="8dp"
						android:padding="7dp"
						android:gravity="center"
						android:background="#2518FFFF"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_equalizer_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/icon2"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:padding="7dp"
						android:gravity="center"
						android:background="#10FFFFFF"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_person_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>

				<!-- Scrollable Tab Content -->
				<ScrollView
					android:id="@+id/vscroll1"
					android:layout_width="match_parent"
					android:paddingLeft="14dp"
					android:paddingRight="14dp"
					android:layout_height="match_parent"
					android:fillViewport="true">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingRight="2dp"
						android:orientation="vertical">

						<!-- Tab 1: Features -->
						<LinearLayout
							android:id="@+id/l1"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">

							<Button
								android:id="@+id/button1"
								android:layout_width="match_parent"
								android:layout_height="42dp"
								android:layout_marginBottom="8dp"
								android:text="AUTO HEADSHOT  [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false"
								android:letterSpacing="0.03" />

							<Button
								android:id="@+id/button2"
								android:layout_width="match_parent"
								android:layout_height="42dp"
								android:layout_marginBottom="8dp"
								android:text="AIM LOCK  [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false"
								android:letterSpacing="0.03" />

							<Button
								android:id="@+id/button3"
								android:layout_width="match_parent"
								android:layout_height="42dp"
								android:layout_marginBottom="8dp"
								android:text="HOLOGRAM  [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false"
								android:letterSpacing="0.03" />
						</LinearLayout>

						<!-- Tab 2: System Info -->
						<LinearLayout
							android:id="@+id/l2"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:visibility="gone"
							android:background="@drawable/bg_info_card"
							android:padding="10dp"
							android:orientation="vertical">

							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="6dp"
								android:text="SYSTEM INFO"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#18FFFF"
								android:letterSpacing="0.06"
								android:focusable="false" />

							<LinearLayout
								android:id="@+id/linear9"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview8"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="USER : "
									android:textSize="11sp"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview12"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="User"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFEB3B"
									android:focusable="false" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/linear10"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview9"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="CREATOR : "
									android:textSize="11sp"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview13"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="ModX Lab"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#00E676"
									android:focusable="false" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/linear11"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview10"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="REGISTER : "
									android:textSize="11sp"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview14"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Active"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#18FFFF"
									android:focusable="false" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/linear12"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview11"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="EXPIRED : "
									android:textSize="11sp"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview15"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Unlimited"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FF5252"
									android:focusable="false" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/linear13"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview7"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="TYPE : "
									android:textSize="11sp"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview16"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="SAFE"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#00E676"
									android:focusable="false" />
							</LinearLayout>
						</LinearLayout>

					</LinearLayout>
				</ScrollView>
			</LinearLayout>

			<!-- Bottom Actions -->
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="5dp"
				android:paddingLeft="6dp"
				android:paddingRight="6dp"
				android:paddingBottom="6dp"
				android:gravity="bottom"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="bottom|left"
					android:text="EXIT"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="#18FFFF"
					android:padding="0dp"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="0dp"
					android:layout_height="1dp"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="bottom|right"
					android:text="CLOSE"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="#18FFFF"
					android:padding="0dp"
					android:focusable="false" />
			</LinearLayout>

		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
