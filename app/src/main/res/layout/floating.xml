<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="160dp"
		android:layout_height="38dp"
		android:layout_margin="4dp"
		android:background="@drawable/bg_glass_input"
		android:gravity="center"
		android:orientation="horizontal"
		android:paddingLeft="10dp"
		android:paddingRight="10dp">
		<LinearLayout
			android:id="@+id/light"
			android:layout_width="8dp"
			android:layout_height="8dp"
			android:background="#00E676" />
		<TextView
			android:id="@+id/textview5"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:text="ModX Lab"
			android:textSize="14sp"
			android:textStyle="bold"
			android:textColor="#18FFFF"
			android:focusable="false" />
	</LinearLayout>

	<RelativeLayout
		android:id="@+id/bg"
		android:layout_width="260dp"
		android:layout_height="320dp">
		<LinearLayout
			android:id="@+id/main"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal" />
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="260dp"
			android:layout_height="320dp"
			android:padding="12dp"
			android:orientation="vertical">

			<!-- Header -->
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:paddingBottom="8dp">
				<TextView
					android:id="@+id/textview1"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:text="MODX LAB"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="#18FFFF" />
				<TextView
					android:id="@+id/textview17"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:visibility="gone"
					android:text="PRO"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#18FFFF" />
				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="FREE FIRE MAX"
					android:textSize="10sp"
					android:textStyle="bold"
					android:textColor="#FFD700"
					android:letterSpacing="0.05"
					android:focusable="false" />
			</LinearLayout>

			<!-- Content Area -->
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:orientation="horizontal">

				<!-- Side Navigation Tabs -->
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="44dp"
					android:layout_height="match_parent"
					android:gravity="top|center_horizontal"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/icon1"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:layout_marginBottom="8dp"
						android:padding="6dp"
						android:gravity="center"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_equalizer_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/icon2"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:padding="6dp"
						android:gravity="center"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/ic_person_white"
							android:scaleType="fitCenter"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>

				<!-- Scrollable Tab Content -->
				<ScrollView
					android:id="@+id/vscroll1"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:fillViewport="true">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingLeft="4dp"
						android:paddingRight="4dp"
						android:orientation="vertical">

						<!-- Tab 1: Features -->
						<LinearLayout
							android:id="@+id/l1"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">
							<Button
								android:id="@+id/button1"
								android:layout_width="match_parent"
								android:layout_height="38dp"
								android:layout_marginBottom="8dp"
								android:text="AUTO HEADSHOT [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false" />
							<Button
								android:id="@+id/button2"
								android:layout_width="match_parent"
								android:layout_height="38dp"
								android:layout_marginBottom="8dp"
								android:text="AIM LOCK [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false" />
							<Button
								android:id="@+id/button3"
								android:layout_width="match_parent"
								android:layout_height="38dp"
								android:layout_marginBottom="8dp"
								android:text="HOLOGRAM [OFF]"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								android:textAllCaps="false" />
						</LinearLayout>

						<!-- Tab 2: System Info -->
						<LinearLayout
							android:id="@+id/l2"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:visibility="gone"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="6dp"
								android:text="INFO PANEL"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#18FFFF"
								android:focusable="false" />
							<LinearLayout
								android:id="@+id/linear9"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview8"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="USER : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview12"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="User"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FFEB3B"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear10"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview9"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="CREATOR : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview13"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="ModX Lab"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#00E676"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear11"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview10"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="REGISTER : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview14"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Active"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#18FFFF"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear12"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview11"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="EXPIRED : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview15"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Unlimited"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#FF5252"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear13"
								android:layout_width="match_parent"
								android:layout_height="22dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview7"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="TYPE : "
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#94A3B8"
									android:focusable="false" />
								<TextView
									android:id="@+id/textview16"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="SAFE"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="#00E676"
									android:focusable="false" />
							</LinearLayout>
						</LinearLayout>

					</LinearLayout>
				</ScrollView>
			</LinearLayout>

			<!-- Bottom Actions -->
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview3"
					android:layout_width="80dp"
					android:layout_height="32dp"
					android:gravity="center"
					android:text="EXIT"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="0dp"
					android:layout_height="1dp"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textview4"
					android:layout_width="80dp"
					android:layout_height="32dp"
					android:gravity="center"
					android:text="CLOSE"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:focusable="false" />
			</LinearLayout>

		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
